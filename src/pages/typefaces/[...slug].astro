---
import Base      from '../../layouts/Base.astro';
import SpecimenTesterOtf from '../../components/SpecimenTesterOtf.jsx';
import BottomBar from '../../components/BottomBar.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

export async function getStaticPaths() {
  const all = getAllTypefaces();
  return all.map((tf, i) => ({
    params: { slug: tf.slug },
    props: {
      tf,
      prev: all[(i - 1 + all.length) % all.length].slug,
      next: all[(i + 1) % all.length].slug,
    },
  }));
}

const { tf, prev, next } = Astro.props;

/* Build @font-face for every OTF variant of this typeface */
const fam      = tf.title.replace(/"/g, '\\"');
const fontFaces = tf.otfVariants
  .map(v =>
    `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`
  )
  .join('\n');

/* Default variant used for the static hero */
const dv    = tf.defaultVariant;
const heroWt  = dv?.weight ?? 400;
const heroSty = dv?.style  ?? 'normal';

/* Convert mainSize ("6em") → px for the interactive tester's initial size */
const mainSizePx = Math.round((parseFloat(tf.mainSize) || 6) * 16);
---

<Base
  title={`${tf.title} — Umprum Type`}
  description={tf.aboutFont || `${tf.title} by ${tf.designer}${tf.year ? `, ${tf.year}` : ''}.`}
>
  <style set:html={fontFaces}></style>

  <article class="container tf-page">

    <!-- nav -->
    <header class="tf-page__head" data-reveal>
      <nav class="tf-page__nav">
        <a href="/typefaces">← all typefaces</a>
        <span>
          <a href={`/typefaces/${prev}`}>← prev</a>
          {' · '}
          <a href={`/typefaces/${next}`}>next →</a>
        </span>
      </nav>

      <!-- font name rendered in the typeface itself -->
      <h1
        class="tf-page__title"
        style={`font-family:"${fam}",var(--font-ui);font-weight:${heroWt};font-style:${heroSty}`}
      >{tf.title}</h1>

      <!-- meta chips -->
      <div class="tf-page__meta">
        {tf.otfVariants.length > 1 && (
          <span>{tf.otfVariants.length} styles</span>
        )}
        <span>{tf.designer}</span>
        {tf.year && <span>{tf.year}</span>}
      </div>
    </header>

    <!-- static hero specimen: mainText at the curator's chosen size -->
    {tf.mainText && (
      <div
        class="tf-hero"
        style={`font-family:"${fam}",var(--font-ui);font-size:${tf.mainSize};font-weight:${heroWt};font-style:${heroSty};`}
        aria-hidden="true"
      >{tf.mainText}</div>
    )}

    <!-- interactive tester (React island) -->
    <SpecimenTesterOtf
      client:load
      fontFamily={tf.title}
      variants={tf.otfVariants}
      specimens={tf.styleTexts}
      mainStyleNo={tf.mainStyleNo}
      initialSize={mainSizePx}
      prevSlug={prev}
      nextSlug={next}
    />

    <!-- about the typeface -->
    {tf.aboutFont && (
      <section class="tf-page__about" data-reveal>
        <h2>About</h2>
        <p>{tf.aboutFont}</p>
      </section>
    )}

    <!-- designer info (HTML from info.txt) -->
    {tf.aboutDesigner && (
      <section class="tf-page__author" data-reveal>
        <h2>Designer</h2>
        <p set:html={tf.aboutDesigner} class="tf-page__author-body"></p>
      </section>
    )}

  </article>

  <BottomBar client:load name={tf.title} prevSlug={prev} nextSlug={next} />

  <style>
    /* static hero specimen block */
    .tf-hero {
      padding: var(--space-7) 0;
      border-bottom: 1px solid var(--border);
      line-height: 1.0;
      word-break: break-word;
      hyphens: auto;
      overflow: hidden;
    }

    /* fix <a> and <br> inside aboutDesigner HTML */
    .tf-page__author-body a {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .tf-page__author-body a:hover { color: var(--text-muted); }

    /* reset button in tester controls */
    :global(.specimen__reset) {
      font-size: var(--step-0);
      color: var(--text-subtle);
      border: none !important;
      padding: 0 var(--space-2) !important;
    }
    :global(.specimen__reset:hover) { color: var(--text) !important; }
  </style>
</Base>
