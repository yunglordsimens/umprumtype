---
import Base from '../../layouts/Base.astro';
import SpecimenTesterOtf from '../../components/SpecimenTesterOtf.jsx';
import BottomBar from '../../components/BottomBar.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

export async function getStaticPaths() {
  const all = getAllTypefaces();
  return all.map((tf, i) => ({
    params: { slug: tf.slug },
    props: {
      tf,
      prev: all[(i - 1 + all.length) % all.length].slug,
      next: all[(i + 1) % all.length].slug,
    },
  }));
}

const { tf, prev, next } = Astro.props;

const fontFaces = tf.otfVariants
  .map(v =>
    `@font-face{font-family:"${tf.title.replace(/"/g, '\\"')}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`
  )
  .join('\n');
---
<Base
  title={`${tf.title} — Umprum Type`}
  description={tf.aboutFont || `${tf.title} by ${tf.designer}, ${tf.year}.`}
>
  <style set:html={fontFaces}></style>

  <article class="container tf-page">
    <header class="tf-page__head" data-reveal>
      <nav class="tf-page__nav">
        <a href="/typefaces">← all typefaces</a>
        <span>
          <a href={`/typefaces/${prev}`}>← prev</a> · <a href={`/typefaces/${next}`}>next →</a>
        </span>
      </nav>

      <h1
        class="tf-page__title"
        style={`font-family:"${tf.title.replace(/"/g, '\\"')}",var(--font-ui)`}
      >{tf.mainText || tf.title}</h1>

      <div class="tf-page__meta">
        {tf.otfVariants.length > 0 && <span>{tf.otfVariants.length} style{tf.otfVariants.length > 1 ? 's' : ''}</span>}
        <span>{tf.designer}</span>
        {tf.year && <span>{tf.year}</span>}
        {tf.tags.length > 0 && <span>{tf.tags.join(', ')}</span>}
      </div>
    </header>

    <SpecimenTesterOtf
      client:load
      fontFamily={tf.title}
      variants={tf.otfVariants}
      specimens={tf.styleTexts}
      mainStyleNo={tf.mainStyleNo}
      prevSlug={prev}
      nextSlug={next}
    />

    {tf.aboutFont && (
      <section class="tf-page__about" data-reveal>
        <h2>About</h2>
        <p>{tf.aboutFont}</p>
      </section>
    )}

    {tf.aboutDesigner && (
      <section class="tf-page__author" data-reveal>
        <h2>Designer</h2>
        <p set:html={tf.aboutDesigner}></p>
      </section>
    )}

    {tf.tags.length > 0 && (
      <section class="tf-page__tags" data-reveal>
        <ul class="tag-list">{tf.tags.map(t => <li>#{t}</li>)}</ul>
      </section>
    )}
  </article>

  <BottomBar client:load name={tf.title} prevSlug={prev} nextSlug={next} />
</Base>
