---
import Base from '../../layouts/Base.astro';
import TypefaceIsland from '../../components/TypefaceIsland.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

const all = getAllTypefaces();

const fontFaces = all
  .flatMap(t =>
    t.otfVariants.map(v => {
      const fam = t.title.replace(/"/g, '\\"');
      return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("woff2");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
    })
  )
  .join('\n');

// First rows of the default Name ↑ sort — fetch their fonts right away
const firstFonts = [...all]
  .sort((a, b) => a.title.localeCompare(b.title, 'cs'))
  .slice(0, 4)
  .map(t => t.otfVariants[Math.min(Math.max(0, t.mainStyleNo), t.otfVariants.length - 1)]?.webPath)
  .filter(Boolean);

// SEO: describe every typeface as structured data (invisible)
const SITE = 'https://typoumprum.cz';
const typefacesLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Typefaces — UMPRUM Type',
  url: `${SITE}/typefaces`,
  isPartOf: { '@id': `${SITE}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: [...all]
      .sort((a, b) => a.title.localeCompare(b.title, 'cs'))
      .map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          genre: 'Typeface',
          name: t.title,
          url: `${SITE}/typefaces#${t.slug}`,
          ...(t.designer && t.designer !== 'Unknown' ? { creator: { '@type': 'Person', name: t.designer } } : {}),
          ...(t.year ? { dateCreated: String(t.year) } : {}),
          ...(t.aboutFont ? { description: t.aboutFont.replace(/\s+/g, ' ').trim().slice(0, 500) } : {}),
          ...(t.tags?.length ? { keywords: t.tags.join(', ') } : {}),
          sourceOrganization: { '@id': `${SITE}/#org` },
        },
      })),
  },
};
---
<Base
  title="Typefaces — Umprum Type"
  description={`Archive of ${all.length} typefaces designed in the type design studio at UMPRUM, Prague — text, display and script faces, Cyrillic and blackletter, from historical revivals to experimental type.`}
  heading="Typefaces designed at UMPRUM Type, Prague"
  jsonLd={typefacesLd}
  bodyClass="lib-page"
>
  {firstFonts.map(href => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  <style set:html={fontFaces}></style>
  <TypefaceIsland client:load typefaces={all} />
</Base>
