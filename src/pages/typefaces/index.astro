---
import Base from '../../layouts/Base.astro';
import TypefaceIsland from '../../components/TypefaceIsland.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

const all = getAllTypefaces();

const fontFaces = all
  .flatMap(t =>
    t.otfVariants.map(v => {
      const fam = t.title.replace(/"/g, '\\"');
      return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("woff2");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
    })
  )
  .join('\n');
---
<Base
  title="Typefaces — Umprum Type"
  description="Archive of typefaces designed at the type class of UMPRUM, Prague."
  bodyClass="lib-page"
>
  <style set:html={fontFaces}></style>
  <TypefaceIsland client:load typefaces={all} />
</Base>
