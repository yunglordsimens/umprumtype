---
import Base from '../../layouts/Base.astro';
import TypefaceAccordion from '../../components/TypefaceAccordion.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

const all = getAllTypefaces();

const fontFaces = all
  .flatMap(t =>
    t.otfVariants.map(v => {
      const fam = t.title.replace(/"/g, '\\"');
      return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
    })
  )
  .join('\n');
---
<Base title="Typefaces — Umprum Type" description="Archive of typefaces designed at the type class of UMPRUM, Prague.">
  <style set:html={fontFaces}></style>

  <section class="container">
    <header class="page-head" data-reveal>
      <h1>Typefaces</h1>
      <p class="muted">{all.length} designs from the UMPRUM type class.</p>
    </header>

    <TypefaceAccordion client:load typefaces={all} />
  </section>
</Base>
