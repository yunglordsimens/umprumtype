---
import Base from '../../layouts/Base.astro';
import { getAllTypefaces } from '../../lib/typefaces';

const all = getAllTypefaces();
const years = [...new Set(all.map(t => t.year).filter(Boolean))]
  .sort((a, b) => (b ?? 0) - (a ?? 0));

// One @font-face per typeface, using its default variant OTF
const fontFaces = all
  .filter(t => t.defaultVariant)
  .map(t => {
    const v = t.defaultVariant!;
    const fam = t.title.replace(/"/g, '\\"');
    return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
  })
  .join('\n');
---

<Base
  title="Typefaces — Umprum Type"
  description="Archive of typefaces designed at the type class of UMPRUM, Prague."
>
  <style set:html={fontFaces}></style>

  <section class="container">

    <!-- header -->
    <header class="page-head" data-reveal>
      <h1>Typefaces</h1>
      <p class="muted">{all.length} designs from the UMPRUM type class.</p>
    </header>

    <!-- controls -->
    <div class="tf-controls" data-reveal>
      <input
        id="tfSearch"
        type="search"
        placeholder="Search by name or designer…"
        class="tf-search"
        autocomplete="off"
      />
      <div class="tf-sort">
        <button data-sort="name"    aria-pressed="true">A–Z</button>
        <button data-sort="year">year</button>
        <button data-sort="shuffle">shuffle</button>
        <button id="tfRandom">→ random</button>
      </div>
    </div>

    <!-- year filter -->
    {years.length > 0 && (
      <div class="tf-filters" data-reveal>
        <div class="tf-filter-row" data-group="year">
          <span class="tf-filter-label">year</span>
          {years.map(y => (
            <button data-filter="year" data-value={String(y)}>{y}</button>
          ))}
        </div>
      </div>
    )}

    <!-- card grid -->
    <ul class="tf-grid" id="tfGrid" data-reveal-stagger aria-label="Typefaces">
      {all.map(t => {
        const fam  = `"${t.title.replace(/"/g, '\\"')}",var(--font-ui)`;
        const wt   = t.defaultVariant?.weight  ?? 400;
        const sty  = t.defaultVariant?.style   ?? 'normal';
        // Short specimen: mainText preferred, else first styleText excerpt
        const spec = t.mainText
          || (t.styleTexts[0]?.slice(0, 90) ?? '');
        return (
          <li
            class="tf-card"
            data-card
            data-name={t.title.toLowerCase()}
            data-designer={t.designer.toLowerCase()}
            data-year={t.year ?? ''}
          >
            <a href={`/typefaces/${t.slug}`} class="tf-card__link">

              {/* font name rendered in itself — the "live" part */}
              <span
                class="tf-card__name"
                style={`font-family:${fam};font-weight:${wt};font-style:${sty}`}
                aria-hidden="true"
              >{t.title}</span>

              {/* short specimen line in the same font */}
              {spec && (
                <span
                  class="tf-card__specimen"
                  style={`font-family:${fam};font-weight:${wt};font-style:${sty}`}
                >{spec}</span>
              )}

              {/* meta: designer · year */}
              <span class="tf-card__meta">
                <span class="tf-card__designer">{t.designer}</span>
                {t.year && <span class="tf-card__year">{t.year}</span>}
              </span>

            </a>
          </li>
        );
      })}
    </ul>

    <!-- empty state -->
    <p class="tf-empty" id="tfEmpty" hidden>No results.</p>

  </section>

  <style>
    /* ---- card grid ---- */
    .tf-grid {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1px;
      background: var(--border);          /* gap colour = border */
      border: 1px solid var(--border);
      margin-top: var(--space-6);
    }

    .tf-card {
      background: var(--bg);
      transition: background var(--dur-fast) var(--ease);
    }
    .tf-card:hover { background: var(--surface-alt); }
    .tf-card[data-hidden="true"] { display: none; }

    .tf-card__link {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5);
      text-decoration: none;
      color: inherit;
      height: 100%;
      min-height: 200px;
    }
    .tf-card__link:hover { text-decoration: none; }

    /* large name in the typeface */
    .tf-card__name {
      font-size: clamp(1.8rem, 3.5vw, 3rem);
      line-height: 1.05;
      flex: 1;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      word-break: break-word;
      hyphens: auto;
    }

    /* short specimen text, same font, smaller + muted */
    .tf-card__specimen {
      font-size: var(--step--1);
      color: var(--text-muted);
      line-height: 1.4;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    /* designer · year row */
    .tf-card__meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
      font-size: var(--step--1);
      font-family: var(--font-ui);
      margin-top: var(--space-1);
      padding-top: var(--space-3);
      border-top: 1px solid var(--border);
    }
    .tf-card__designer { color: var(--text-muted); }
    .tf-card__year     { color: var(--text-subtle); font-variant-numeric: tabular-nums; }

    .tf-empty { margin-top: var(--space-6); color: var(--text-muted); }
  </style>

  <script>
    const grid  = document.getElementById('tfGrid')!;
    const empty = document.getElementById('tfEmpty') as HTMLElement;
    const cards = () => Array.from(document.querySelectorAll('[data-card]')) as HTMLElement[];

    /* ---- active filters ---- */
    const active: Record<string, Set<string>> = { year: new Set() };

    document.querySelectorAll('[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        const el    = btn as HTMLElement;
        const group = el.dataset.filter!;
        const val   = el.dataset.value!;
        const set   = active[group];
        if (set.has(val)) { set.delete(val); btn.setAttribute('aria-pressed', 'false'); }
        else              { set.add(val);    btn.setAttribute('aria-pressed', 'true');  }
        apply();
      });
    });

    /* ---- search ---- */
    const q = document.getElementById('tfSearch') as HTMLInputElement;
    q.addEventListener('input', apply);

    function apply() {
      const needle = q.value.trim().toLowerCase();
      let visible = 0;
      cards().forEach(c => {
        const matchSearch = !needle
          || (c.dataset.name    ?? '').includes(needle)
          || (c.dataset.designer ?? '').includes(needle);
        const matchYear = active.year.size === 0 || active.year.has(c.dataset.year ?? '');
        const show = matchSearch && matchYear;
        c.dataset.hidden = show ? 'false' : 'true';
        if (show) visible++;
      });
      empty.hidden = visible > 0;
    }

    /* ---- sort ---- */
    let currentSort = 'name';
    document.querySelectorAll('[data-sort]').forEach(btn => {
      btn.addEventListener('click', () => {
        currentSort = (btn as HTMLElement).dataset.sort!;
        document.querySelectorAll('[data-sort]').forEach(b =>
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false')
        );
        sort();
      });
    });

    function shuffle<T>(a: T[]): T[] {
      const r = a.slice();
      for (let i = r.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [r[i], r[j]] = [r[j], r[i]];
      }
      return r;
    }

    function sort() {
      const items = cards();
      let sorted: HTMLElement[];
      if      (currentSort === 'name')    sorted = items.slice().sort((a, b) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'cs'));
      else if (currentSort === 'year')    sorted = items.slice().sort((a, b) => +(b.dataset.year ?? 0) - +(a.dataset.year ?? 0));
      else if (currentSort === 'shuffle') sorted = shuffle(items);
      else sorted = items;
      sorted.forEach(el => grid.appendChild(el));
    }

    sort();   // initial sort (A-Z)

    /* ---- random ---- */
    document.getElementById('tfRandom')?.addEventListener('click', () => {
      const visible = cards().filter(c => c.dataset.hidden !== 'true');
      if (!visible.length) return;
      const pick = visible[Math.floor(Math.random() * visible.length)];
      pick.scrollIntoView({ behavior: 'smooth', block: 'center' });
      pick.querySelector('a')?.animate(
        [{ outline: '2px solid var(--text)' }, { outline: '2px solid transparent' }],
        { duration: 900, easing: 'var(--ease)' }
      );
    });
  </script>
</Base>
