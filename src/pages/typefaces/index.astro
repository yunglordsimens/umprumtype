---
import Base from '../../layouts/Base.astro';
import TypefaceAccordion from '../../components/TypefaceAccordion.jsx';
import { getAllTypefaces } from '../../lib/typefaces';

const all = getAllTypefaces();

const fontFaces = all
  .flatMap(t =>
    t.otfVariants.map(v => {
      const fam = t.title.replace(/"/g, '\\"');
      return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
    })
  )
  .join('\n');
---
<Base title="Typefaces — Umprum Type" description="Archive of typefaces designed at the type class of UMPRUM, Prague.">
  <style set:html={fontFaces}></style>

  <style>
    /* Accordion list */
    .tfa-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .tfa-item {
      border-bottom: 1px solid var(--border);
    }

    /* Trigger row */
    .tfa-trigger {
      width: 100%;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-5);
      padding: var(--space-4) 0;
      background: none;
      border: none;
      cursor: pointer;
      text-align: left;
      transition: background var(--dur-fast) var(--ease);
    }
    .tfa-trigger:hover {
      background: var(--surface-alt);
    }
    .tfa-trigger__name {
      font-size: var(--step-3);
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--text);
    }
    .tfa-trigger__meta {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      flex-shrink: 0;
      font-size: var(--step--1);
      color: var(--text-muted);
    }
    .tfa-trigger__arrow {
      color: var(--text-subtle);
      transition: transform var(--dur-fast) var(--ease);
      display: inline-block;
    }
    .tfa-trigger.is-open .tfa-trigger__arrow {
      transform: rotate(180deg);
    }
    @media (max-width: 720px) {
      .tfa-trigger__designer { display: none; }
    }

    /* Panel */
    .tfa-panel {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition:
        max-height 600ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tfa-panel__inner {
      padding-bottom: var(--space-7);
    }

    /* About blocks inside accordion */
    .tfa-about {
      margin-top: var(--space-6);
      max-width: var(--measure);
    }
    .tfa-about h3 {
      font-size: var(--step--1);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-subtle);
      margin-bottom: var(--space-3);
      font-weight: 400;
    }
    .tfa-about p,
    .tfa-about--designer p {
      font-size: var(--step-0);
      color: var(--text-muted);
      line-height: 1.6;
    }
    .tfa-about--designer a {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .tfa-about--designer a:hover { color: var(--text-muted); }

    /* specimen reset button inside accordion */
    :global(.tfa-panel .specimen__reset) {
      font-size: var(--step-0);
      color: var(--text-subtle);
      border: none !important;
      padding: 0 var(--space-2) !important;
    }
    :global(.tfa-panel .specimen__reset:hover) { color: var(--text) !important; }
  </style>

  <section class="container">
    <header class="page-head" data-reveal>
      <h1>Typefaces</h1>
      <p class="muted">{all.length} designs from the UMPRUM type class.</p>
    </header>

    <TypefaceAccordion client:load typefaces={all} />
  </section>
</Base>
