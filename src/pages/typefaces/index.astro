---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('typefaces');
all.sort((a, b) => b.data.year - a.data.year || a.data.name.localeCompare(b.data.name));

const classifications = [...new Set(all.map(t => t.data.classification))].sort();
const years = [...new Set(all.map(t => t.data.year))].sort((a, b) => b - a);
const scripts = [...new Set(all.flatMap(t => t.data.scripts))].sort();

const fontFaces = all.flatMap(t =>
  t.data.fonts.map(f =>
    `@font-face{font-family:"${t.data.name}";src:url("${f.file}") format("woff2");font-weight:${f.weight};font-style:${f.style};font-display:swap;}`
  )
).join('\n');

const slugOf = (entry) => entry.id.replace(/\.md$/, '');
---
<Base title="Typefaces — Umprum Type" description="Archive of typefaces designed at the type class of UMPRUM, Prague.">
  <style set:html={fontFaces}></style>
  <section class="container">
    <header class="page-head" data-reveal>
      <h1>Typefaces</h1>
      <p class="muted">{all.length} designs from the UMPRUM type class. Filters combine AND across rows, OR within.</p>
    </header>

    <div class="tf-controls" data-reveal>
      <input type="search" placeholder="Search by name or author…" class="tf-search" id="tfSearch" />
      <div class="tf-sort">
        <button data-sort="shuffle" aria-pressed="true">shuffle</button>
        <button data-sort="year">year</button>
        <button data-sort="name">name</button>
        <button data-sort="author">author</button>
        <button id="tfRandom">→ random</button>
      </div>
    </div>

    <div class="tf-filters" data-reveal>
      <div class="tf-filter-row" data-group="classification">
        <span class="tf-filter-label">class</span>
        {classifications.map(c => (
          <button data-filter="classification" data-value={c}>{c}</button>
        ))}
      </div>
      <div class="tf-filter-row" data-group="year">
        <span class="tf-filter-label">year</span>
        {years.map(y => (
          <button data-filter="year" data-value={String(y)}>{y}</button>
        ))}
      </div>
      <div class="tf-filter-row" data-group="script">
        <span class="tf-filter-label">script</span>
        {scripts.map(s => (
          <button data-filter="script" data-value={s}>{s}</button>
        ))}
      </div>
    </div>

    <ul class="tf-list" id="tfList" data-reveal-stagger>
      {all.map(t => (
        <li
          class="tf-row"
          data-row
          data-name={t.data.name.toLowerCase()}
          data-author={(t.data.author || '').toLowerCase()}
          data-year={t.data.year}
          data-classification={t.data.classification}
          data-scripts={(t.data.scripts || []).join(',')}
        >
          <a href={`/typefaces/${slugOf(t)}`} class="tf-row__link">
            <span class="tf-row__name" style={`font-family:"${t.data.name}",var(--font-ui)`}>{t.data.name}</span>
            <span class="tf-row__class">{t.data.classification}</span>
            <span class="tf-row__author">{t.data.author}</span>
            <span class="tf-row__year">{t.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    const list = document.getElementById('tfList');
    if (!list) { /* noop */ }
    const rows = () => Array.from(document.querySelectorAll('[data-row]'));

    // ----- Filters -----
    const active = { classification: new Set(), year: new Set(), script: new Set() };
    document.querySelectorAll('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.getAttribute('data-filter');
        const val = btn.getAttribute('data-value');
        const set = active[group];
        if (set.has(val)) { set.delete(val); btn.setAttribute('aria-pressed', 'false'); }
        else { set.add(val); btn.setAttribute('aria-pressed', 'true'); }
        applyFilters();
      });
    });

    const q = document.getElementById('tfSearch');
    q?.addEventListener('input', applyFilters);

    function applyFilters() {
      const needle = (q?.value || '').trim().toLowerCase();
      rows().forEach((r) => {
        const name = r.dataset.name || '';
        const author = r.dataset.author || '';
        const cls = r.dataset.classification || '';
        const yr = r.dataset.year || '';
        const scr = (r.dataset.scripts || '').split(',');

        const matchSearch = !needle || name.includes(needle) || author.includes(needle);
        const matchCls = active.classification.size === 0 || active.classification.has(cls);
        const matchYr = active.year.size === 0 || active.year.has(yr);
        const matchScr = active.script.size === 0 || scr.some((s) => active.script.has(s));

        r.dataset.hidden = String(!(matchSearch && matchCls && matchYr && matchScr));
      });
    }

    // ----- Sort -----
    let currentSort = 'shuffle';
    const sortBtns = document.querySelectorAll('[data-sort]');
    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentSort = btn.getAttribute('data-sort');
        sortBtns.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
        applySort();
      });
    });

    function shuffle(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function applySort() {
      const items = rows();
      let sorted;
      if (currentSort === 'shuffle') sorted = shuffle(items);
      else if (currentSort === 'year') sorted = items.slice().sort((a, b) => (+b.dataset.year) - (+a.dataset.year));
      else if (currentSort === 'name') sorted = items.slice().sort((a, b) => a.dataset.name.localeCompare(b.dataset.name));
      else if (currentSort === 'author') sorted = items.slice().sort((a, b) => (a.dataset.author || '').localeCompare(b.dataset.author || ''));
      else sorted = items;
      sorted.forEach((el) => list.appendChild(el));
    }
    applySort();

    // ----- Random -----
    document.getElementById('tfRandom')?.addEventListener('click', () => {
      const visible = rows().filter((r) => r.dataset.hidden !== 'true');
      if (!visible.length) return;
      const pick = visible[Math.floor(Math.random() * visible.length)];
      pick.scrollIntoView({ behavior: 'smooth', block: 'center' });
      pick.animate([{ background: 'var(--surface-alt)' }, { background: 'transparent' }], { duration: 1200, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
    });
  </script>
</Base>
