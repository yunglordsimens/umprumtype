---
import Base from '../layouts/Base.astro';
import { getAllTypefaces } from '../lib/typefaces';

const allTypefaces = getAllTypefaces();
const usable = allTypefaces.filter(t => t.defaultVariant && t.defaultVariant.webPath);

const fontFaces = usable.map(t => {
  const v = t.defaultVariant!;
  const fam = t.title.replace(/"/g, '\\"');
  return `@font-face{font-family:"${fam}";src:url("${v.webPath}") format("opentype");font-weight:${v.weight};font-style:${v.style};font-display:swap;}`;
}).join('\n');

const fontsData = usable.map(t => ({
  title: t.title,
  weight: t.defaultVariant!.weight,
  style: t.defaultVariant!.style,
}));

const year = new Date().getFullYear();
---
<Base
  title="Umprum Type"
  description="Archive of typefaces, projects, and writing from the type class at UMPRUM, Prague."
  bodyClass="home-page"
>
  <style set:html={fontFaces}></style>
  <style>
    .home {
      position: fixed;
      top: var(--nav-h);
      right: 0; bottom: 0; left: 0;
      display: grid;
      grid-template-rows: 1fr auto;
      background: #111118;
    }

    .poster {
      position: relative;
      overflow: hidden;
    }

    .poster-word {
      position: absolute;
      color: #f2f2ef;
      white-space: nowrap;
      font-synthesis: none;
      line-height: 1;
      opacity: 0;
      transition:
        opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      user-select: none;
    }

    .home-foot {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 22px;
      font-size: 11px;
      letter-spacing: 0.05em;
      color: rgba(242, 242, 239, 0.35);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(17, 17, 24, 0.5);
    }

    @media (max-width: 640px) {
      .home {
        position: static;
        min-height: calc(100dvh - var(--nav-h));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .poster-word {
        transition: opacity 200ms linear !important;
      }
    }
  </style>

  <div class="home">
    <div class="poster" id="poster"></div>
    <footer class="home-foot">
      <span>Umprum Type · Prague · {year}</span>
    </footer>
  </div>

  <script is:inline define:vars={{ fontsData }}>
    (function () {
      var SLOTS = [
        { l: 3,  t: 5,  s: 13,  r: -1.2, o: 0.93 },
        { l: 40, t: 2,  s: 4,   r:  0.7, o: 0.58 },
        { l: 62, t: 7,  s: 8,   r:  1.5, o: 0.82 },
        { l: 5,  t: 30, s: 5,   r: -0.5, o: 0.68 },
        { l: 30, t: 26, s: 15,  r: -2.0, o: 0.95 },
        { l: 72, t: 38, s: 3.5, r:  1.0, o: 0.54 },
        { l: 6,  t: 57, s: 8,   r:  0.4, o: 0.78 },
        { l: 44, t: 55, s: 5,   r: -0.8, o: 0.64 },
        { l: 65, t: 60, s: 10,  r:  1.8, o: 0.88 },
        { l: 2,  t: 80, s: 3.5, r:  0,   o: 0.52 },
        { l: 33, t: 77, s: 7,   r: -1.0, o: 0.74 },
        { l: 65, t: 82, s: 3.5, r:  0.6, o: 0.58 },
      ];

      var SLOTS_MOBILE = [
        { l: 2, t: 5,  s: 9,  r: -1.0, o: 0.90 },
        { l: 3, t: 20, s: 6,  r:  0.7, o: 0.72 },
        { l: 2, t: 35, s: 10, r: -0.5, o: 0.88 },
        { l: 4, t: 52, s: 6,  r:  0.8, o: 0.70 },
        { l: 2, t: 65, s: 8,  r: -0.8, o: 0.82 },
        { l: 3, t: 80, s: 5,  r:  0.4, o: 0.62 },
      ];

      var isMobile = window.matchMedia('(max-width: 640px)').matches;
      var slots = isMobile ? SLOTS_MOBILE : SLOTS;

      var shuffled = fontsData.slice().sort(function () { return Math.random() - 0.5; });
      var picked = shuffled.slice(0, slots.length);

      var poster = document.getElementById('poster');
      if (!poster) return;

      var words = picked.map(function (font, i) {
        var slot = slots[i];
        var el = document.createElement('span');
        el.className = 'poster-word';
        el.textContent = font.title;
        el.style.left = slot.l + '%';
        el.style.top  = slot.t + '%';
        el.style.fontSize   = slot.s + 'vw';
        el.style.fontFamily = '"' + font.title + '", sans-serif';
        el.style.fontWeight = font.weight;
        el.style.fontStyle  = font.style;
        el.style.transform  = 'translateY(24px) rotate(' + slot.r + 'deg)';
        poster.appendChild(el);
        return { el: el, slot: slot };
      });

      function reveal() {
        words.forEach(function (w, i) {
          setTimeout(function () {
            w.el.style.opacity   = w.slot.o;
            w.el.style.transform = 'translateY(0) rotate(' + w.slot.r + 'deg)';
          }, i * 90);
        });
      }

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(reveal);
      } else {
        setTimeout(reveal, 500);
      }
    })();
  </script>
</Base>
