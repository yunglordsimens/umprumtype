---
import Base from '../../layouts/Base.astro';
import ProjectsIsland from '../../components/ProjectsIsland.jsx';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('projects'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slugOf = (e: { id: string }) => e.id.replace(/\.md$/, '');

const rendered = await Promise.all(
  entries.map(async e => ({ slug: slugOf(e), Content: (await render(e)).Content }))
);

const posts = entries.map(e => ({
  slug:        slugOf(e),
  title:       e.data.title,
  date:        e.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
  dateIso:     e.data.date.toISOString(),
  author:      e.data.author    ?? null,
  category:    e.data.category,
  tags:        e.data.tags      ?? [],
  excerpt:     e.data.excerpt   ?? null,
  gallery:     e.data.gallery   ?? [],
  purchasable: e.data.purchasable ?? false,
  contact:     e.data.contact   ?? null,
}));
---
<Base
  title="Projects — Umprum Type"
  description="Exhibitions, workshops, publications, and collaborations from the UMPRUM type class."
  bodyClass="lib-page"
>
  <div class="post-content-store" aria-hidden="true">
    {rendered.map(({ slug, Content }) => (
      <div data-post-slug={slug}><Content /></div>
    ))}
  </div>

  <ProjectsIsland client:load posts={posts} />
</Base>
