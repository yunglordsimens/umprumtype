---
import Base from '../layouts/Base.astro';
import StoreIsland from '../components/StoreIsland.jsx';
import { getCollection, render } from 'astro:content';

const [allProjects, allJournal] = await Promise.all([
  getCollection('projects'),
  getCollection('journal'),
]);

const slugOf = (e: { id: string }) => e.id.replace(/\.md$/, '');

// Collect purchasable entries from both collections
const purchasable = [
  ...allProjects.filter(p => p.data.purchasable).map(e => ({ ...e, _col: 'projects' as const })),
  ...allJournal .filter(e => e.data.purchasable).map(e => ({ ...e, _col: 'journal'  as const })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Build-time render for content store
const rendered = await Promise.all(
  purchasable.map(async e => ({ slug: slugOf(e), Content: (await render(e)).Content }))
);

// Serialisable metadata for the React island
const items = purchasable.map(e => {
  const d = e.data;
  const blocks = (d.blocks ?? []) as any[];
  const blockImages = blocks.filter((b: any) => b.type === 'images').flatMap((b: any) => b.items ?? []);
  return {
    slug:       slugOf(e),
    title:      d.title,
    author:     d.author     ?? null,
    year:       d.date.getFullYear(),
    date:       d.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
    dateIso:    d.date.toISOString(),
    category:   d.category,
    tags:       d.tags       ?? [],
    excerpt:    d.excerpt    ?? null,
    contact:    d.contact    ?? null,
    storeImage: (d as any).storeImage ?? null,
    gallery:    [...(d.gallery ?? []), ...blockImages],
  };
});
---
<Base
  title="Store — Umprum Type"
  description="Prints, zines, and objects from the UMPRUM type class. Contact authors directly."
  bodyClass="lib-page"
>
  <div class="post-content-store" aria-hidden="true">
    {rendered.map(({ slug, Content }) => (
      <div data-post-slug={slug}>
        <Content />
      </div>
    ))}
  </div>

  <StoreIsland client:load items={items} />
</Base>
