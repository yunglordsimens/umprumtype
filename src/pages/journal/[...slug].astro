---
import Base from '../../layouts/Base.astro';
import FlexContent from '../../components/FlexContent.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('journal');
  return all.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={`${d.title} — Umprum Type`} description={d.excerpt || d.title}>
  <article class="post">
    <div class="container">
      <header class="post__head measure" data-reveal>
        <div class="post__meta">
          <time datetime={d.date.toISOString()}>{d.date.toISOString().slice(0, 10)}</time>
          <span>{d.category}</span>
          {d.author && <span>{d.author}</span>}
        </div>
        <h1 class="post__title">{d.title}</h1>
        {d.excerpt && <p class="muted" style="font-size:var(--step-1);">{d.excerpt}</p>}
      </header>

      {d.blocks && d.blocks.length > 0 ? (
        <FlexContent blocks={d.blocks} />
      ) : (
        <div class="post__body measure" data-reveal>
          <Content />
        </div>
      )}

      <nav class="post__back measure">
        <a href="/journal">← All journal</a>
      </nav>
    </div>
  </article>
</Base>
