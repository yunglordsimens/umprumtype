---
import Base from '../../layouts/Base.astro';
import FlexContent from '../../components/FlexContent.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('journal');
  return all.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// SEO (invisible): real description, share image, Article structured data
const SITE = 'https://typoumprum.cz';
const plain = (entry.body || '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#>*_`~|-]+/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const clip = (t) => (t.length > 158 ? t.slice(0, 155).replace(/\s+\S*$/, '') + '…' : t);
const title = d.title.trim();
const seoDescription = clip((d.excerpt || plain || `${title} — journal of the UMPRUM type design studio, Prague.`).trim());
const shareImage = d.storeImage || d.gallery?.[0] || undefined;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: seoDescription,
  datePublished: d.date.toISOString(),
  url: `${SITE}/journal/${entry.id.replace(/\.md$/, '')}`,
  ...(shareImage ? { image: new URL(shareImage, SITE + '/').href } : {}),
  ...(d.author ? { author: { '@type': 'Person', name: d.author } } : { author: { '@id': `${SITE}/#org` } }),
  publisher: { '@id': `${SITE}/#org` },
  ...(d.tags?.length ? { keywords: d.tags.join(', ') } : {}),
};
---
<Base title={`${title} — Umprum Type`} description={seoDescription} image={shareImage} jsonLd={articleLd} ogType="article">
  <article class="post">
    <div class="container">
      <header class="post__head measure" data-reveal>
        <div class="post__meta">
          <time datetime={d.date.toISOString()}>{d.date.toISOString().slice(0, 10)}</time>
          <span>{d.category}</span>
          {d.author && <span>{d.author}</span>}
        </div>
        <h1 class="post__title">{d.title}</h1>
        {d.excerpt && <p class="muted" style="font-size:var(--step-1);">{d.excerpt}</p>}
      </header>

      {d.blocks && d.blocks.length > 0 ? (
        <FlexContent blocks={d.blocks} />
      ) : (
        <div class="post__body measure" data-reveal>
          <Content />
        </div>
      )}

      <nav class="post__back measure">
        <a href="/journal">← All journal</a>
      </nav>
    </div>
  </article>
</Base>
