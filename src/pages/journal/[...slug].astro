---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('journal');
  return all.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

let titleFamily = null;
let fontFaceCss = '';

if (d.relatedTypeface) {
  const typefaces = await getCollection('typefaces');
  const tf = typefaces.find(t => t.id.replace(/\.md$/, '') === d.relatedTypeface);
  if (tf) {
    titleFamily = tf.data.name;
    fontFaceCss = tf.data.fonts.map(f =>
      `@font-face{font-family:"${tf.data.name}";src:url("${f.file}") format("woff2");font-weight:${f.weight};font-style:${f.style};font-display:swap;}`
    ).join('\n');
  }
}
---
<Base title={`${d.title} — Umprum Type`} description={d.excerpt || d.title} image={d.heroImage || d.cover}>
  {fontFaceCss && <style set:html={fontFaceCss}></style>}
  <article class="post">
    {d.heroImage && (
      <figure class="post__hero" data-reveal>
        <img src={d.heroImage} alt={d.title} loading="eager" />
      </figure>
    )}

    {d.gallery && d.gallery.length > 0 && (
      <div class="post__gallery" data-reveal>
        {d.gallery.map(img => <img src={img} alt="" loading="lazy" />)}
      </div>
    )}

    <div class="container">
      <header class="post__head measure" data-reveal>
        <div class="post__meta">
          <time datetime={d.date.toISOString()}>{d.date.toISOString().slice(0, 10)}</time>
          <span>{d.category}</span>
          {d.author && <span>{d.author}</span>}
        </div>
        <h1 class="post__title" style={titleFamily ? `font-family:"${titleFamily}",var(--font-ui)` : ''}>{d.title}</h1>
        {d.excerpt && <p class="muted" style="font-size:var(--step-1);">{d.excerpt}</p>}
      </header>

      <div class="post__body measure" data-reveal>
        <Content />
      </div>

      <nav class="post__back measure">
        <a href="/journal">← All journal</a>
      </nav>
    </div>
  </article>
</Base>
