---
import Base from '../../layouts/Base.astro';
import ArchiveIsland from '../../components/ArchiveIsland.jsx';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('journal'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slugOf = (e: { id: string }) => e.id.replace(/\.md$/, '');

// Build-time render: each entry's Content component for the hidden DOM store
const rendered = await Promise.all(
  entries.map(async e => ({ slug: slugOf(e), Content: (await render(e)).Content }))
);

// Serialisable metadata passed to the React island
const posts = entries.map(e => ({
  slug:        slugOf(e),
  title:       e.data.title,
  date:        e.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }),
  dateIso:     e.data.date.toISOString(),
  author:      e.data.author    ?? null,
  category:    e.data.category,
  tags:        e.data.tags      ?? [],
  excerpt:     e.data.excerpt   ?? null,
  gallery:     e.data.gallery   ?? [],
  purchasable: e.data.purchasable ?? false,
  contact:     e.data.contact   ?? null,
}));
---
<Base
  title="Journal — Umprum Type"
  description="Essays, interviews, reviews, and news from the UMPRUM type class."
>
  <section class="container">
    <header class="page-head" data-reveal>
      <h1>Journal</h1>
      <p class="muted">{entries.length} entries — essays, interviews, process notes.</p>
    </header>

    <!--
      Hidden build-time content store.
      React island reads innerHTML by [data-post-slug] when a post is opened.
    -->
    <div class="post-content-store" aria-hidden="true">
      {rendered.map(({ slug, Content }) => (
        <div data-post-slug={slug}>
          <Content />
        </div>
      ))}
    </div>

    <ArchiveIsland client:load posts={posts} />
  </section>
</Base>
