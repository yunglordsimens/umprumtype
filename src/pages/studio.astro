---
import StudioPage from '../components/StudioPage.jsx';
import { getAllTypefaces } from '../lib/typefaces';
import '../styles/global.css';

const fontData = getAllTypefaces()
  .filter(tf => tf.defaultVariant)
  .map(tf => ({
    family: tf.title,
    path: tf.defaultVariant.webPath,
    weight: tf.defaultVariant.weight,
  }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Studio — UMPRUM Type</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="studio-body">
    <StudioPage client:load fontData={fontData} />
  </body>
</html>
