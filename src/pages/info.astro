---
import Base from '../layouts/Base.astro';
---
<Base title="Info — Umprum Type" description="Type design studio at UMPRUM, Prague.">
  <div class="info-page">
    <div class="info-body">
      <p>UMPRUM Type is the type design studio at the Academy of Arts, Architecture and Design in Prague (UMPRUM). The class is dedicated to typeface design, calligraphy, and typographic research — from historical reconstructions to experimental display type.</p>
      <p>This site is an evolving archive of work produced in and around the class: typefaces, projects, and writing. It also hosts a library of typography books collected by the studio.</p>
    </div>
  </div>
</Base>

<style>
  .info-page {
    padding: calc(var(--nav-h) / 2) var(--gutter) var(--space-10);
  }
  .info-body {
    width: var(--text-col);
    max-width: 100%;
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .info-body p + p {
    margin-top: var(--space-4);
  }
</style>
