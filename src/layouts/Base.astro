---
import '../styles/global.css';
import SearchIsland from '../components/SearchIsland.jsx';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bodyClass?: string;
}

const {
  title = 'UMPRUM Type',
  description = 'Typography studio at UMPRUM, Prague — typefaces, projects, and journal.',
  image,
  bodyClass,
} = Astro.props;

const url = Astro.url.href;
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isActive = (prefix: string) =>
  pathname === prefix || pathname.startsWith(prefix + '/') || (prefix !== '/' && pathname.startsWith(prefix));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Svar/3_Svar%20Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Svar/2_Svar%20Light.woff2" crossorigin />
  </head>
  <body class={bodyClass || undefined}>
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
    <nav class="site-nav" id="siteNav" data-hidden="false" data-menu="closed">
      <div class="container site-nav__inner">
        <a href="/" class="site-nav__logo">UMPRUM Type</a>
        <button class="site-nav__burger" type="button" aria-label="Menu" aria-controls="siteNavLinks" aria-expanded="false">Menu</button>
        <ul class="site-nav__links" id="siteNavLinks">
          <li><a href="/typefaces" aria-current={isActive('/typefaces') ? 'page' : undefined}>Typefaces</a></li>
          <li><a href="/projects"  aria-current={isActive('/projects')  ? 'page' : undefined}>Projects</a></li>
          <li><a href="/journal"   aria-current={isActive('/journal')   ? 'page' : undefined}>Journal</a></li>
          <li><a href="/store"     aria-current={isActive('/store')     ? 'page' : undefined}>Store</a></li>
          <li><a href="/library"   aria-current={isActive('/library')   ? 'page' : undefined}>Library</a></li>
          <li><a href="/info"      aria-current={isActive('/info')      ? 'page' : undefined}>Info</a></li>
          <li class="site-nav__search-mobile"><SearchIsland client:load /></li>
          <li id="anim-controls-slot" class="site-nav__anim-slot"></li>
        </ul>
        <div class="site-nav__search">
          <SearchIsland client:load />
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="siteFooter" data-expanded={isActive('/info') ? 'true' : 'false'}>
      <div class="container site-footer__inner">
        <span>Umprum Type</span>
        <span>Prague · {year}</span>
      </div>
      <div class="site-footer__naki-rule"></div>
      <div class="container site-footer__naki">
        <p>Projekt byl financován z prostředků Programu na podporu aplikovaného výzkumu v oblasti národní a kulturní identity (NAKI III) Ministerstva kultury ČR v rámci projektu Místa tvořivosti. Uměleckoprůmyslové vzdělávání: konstrukce identit, záchrana minulosti a design budoucnosti (DH23P03OVV061).</p>
        <p>This project was created with financial support from the Ministry of Culture of the Czech Republic as part of the Program for the Applied Research of National and Cultural Identity (NAKI III). It is one of the outcomes of the project Sites of Creativity. Arts and Crafts Education: Constructing Identities, Rescuing Heritage, Designing the Future (DH23P03OVV061).</p>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const revealEls = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Nav hide on scroll down, show on scroll up + scroll progress
      const nav = document.getElementById('siteNav');
      const progress = document.getElementById('scrollProgress');
      if (nav) {
        let lastY = window.scrollY;
        let ticking = false;
        const threshold = 8;
        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const y = window.scrollY;
            const dy = y - lastY;
            if (y < 80) {
              nav.dataset.hidden = 'false';
            } else if (Math.abs(dy) > threshold) {
              nav.dataset.hidden = dy > 0 ? 'true' : 'false';
            }
            if (Math.abs(dy) > threshold && nav.dataset.menu === 'open') {
              closeMenu();
            }
            if (progress) {
              const h = document.documentElement.scrollHeight - window.innerHeight;
              const pct = h > 0 ? (y / h) * 100 : 0;
              progress.style.width = pct + '%';
            }
            lastY = y;
            ticking = false;
          });
        }, { passive: true });

        // Burger toggle (persistent across page navigation via sessionStorage)
        const burger = nav.querySelector('.site-nav__burger');
        const setMenu = (state) => {
          nav.dataset.menu = state;
          burger?.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
          try { sessionStorage.setItem('siteMenu', state); } catch (_) {}
        };
        const closeMenu = () => setMenu('closed');
        // Restore persisted state on page load
        try {
          if (sessionStorage.getItem('siteMenu') === 'open') setMenu('open');
        } catch (_) {}
        burger?.addEventListener('click', () => {
          setMenu(nav.dataset.menu === 'open' ? 'closed' : 'open');
        });
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });

      }

      // Footer toggle (click locks expand; second click closes)
      const siteFooter = document.getElementById('siteFooter');
      siteFooter?.addEventListener('click', () => {
        const open = siteFooter.dataset.expanded === 'true';
        siteFooter.dataset.expanded = open ? 'false' : 'true';
      });

    </script>
  </body>
</html>
